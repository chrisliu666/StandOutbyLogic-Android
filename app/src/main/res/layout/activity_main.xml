<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <LinearLayout
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingTop="10dp"
        android:paddingRight="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/titleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:text="@string/title"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/timerText"
                style="@style/MutedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="00:00" />

            <TextView
                android:id="@+id/mistakesText"
                style="@style/MutedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="错误 0/3" />

            <TextView
                android:id="@+id/hintsText"
                style="@style/MutedText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="提示 3" />

            <TextView
                android:id="@+id/menuBtn"
                style="@style/PadButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/settings"
                android:gravity="center"
                android:text="@string/menu"
                android:textSize="20sp" />
        </LinearLayout>

        <com.standoutbylogic.sudoku.ui.SudokuBoardView
            android:id="@+id/board"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1" />

        <com.standoutbylogic.sudoku.ui.NumberProgressView
            android:id="@+id/numberProgress"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/adaLine"
            style="@style/MutedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/ada_ready" />

        <LinearLayout
            android:id="@+id/keypadRow"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/actionsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/confirmBtn"
                style="@style/ActionButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/confirm" />

            <Button
                android:id="@+id/clearBtn"
                style="@style/ActionButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:text="@string/clear" />

            <Button
                android:id="@+id/hintBtn"
                style="@style/ActionButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/hint" />
        </LinearLayout>

        <Button
            android:id="@+id/againBtn"
            style="@style/ActionButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/again"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/drawerOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <View
            android:id="@+id/drawerScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/scrim" />

        <ScrollView
            android:id="@+id/drawerPanel"
            android:layout_width="300dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="@drawable/bg_panel"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/settings"
                    android:textColor="@color/ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/difficulty" />

                <RadioGroup
                    android:id="@+id/difficultyGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioEasy"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="@string/easy"
                        android:textColor="@color/ink"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/radioMedium"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="@string/medium"
                        android:textColor="@color/ink"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/radioHard"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="@string/hard"
                        android:textColor="@color/ink"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/radioExpert"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="@string/expert"
                        android:textColor="@color/ink"
                        android:textSize="14sp" />
                </RadioGroup>

                <Button
                    android:id="@+id/moreHeader"
                    style="@style/SmallButton"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical|start"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="更多操作 ▸"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/moreBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/currentSeedText"
                        style="@style/MutedText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="当前种子：-" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/seedInput"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_input"
                            android:hint="@string/seed_hint"
                            android:imeOptions="actionDone"
                            android:inputType="textVisiblePassword"
                            android:paddingLeft="8dp"
                            android:paddingRight="8dp"
                            android:singleLine="true"
                            android:textColor="@color/ink"
                            android:textColorHint="@color/muted"
                            android:textSize="13sp" />

                        <Button
                            android:id="@+id/loadSeedBtn"
                            style="@style/SmallButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="6dp"
                            android:minWidth="56dp"
                            android:text="@string/load" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/newGameBtn"
                            style="@style/SmallButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="@string/new_game" />

                        <Button
                            android:id="@+id/undoBtn"
                            style="@style/SmallButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="@string/undo" />

                        <Button
                            android:id="@+id/redoBtn"
                            style="@style/SmallButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="@string/redo" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/resetBtn"
                            style="@style/SmallButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="@string/reset" />

                        <Button
                            android:id="@+id/undoResetBtn"
                            style="@style/SmallButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="6dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:text="@string/undo_reset" />

                        <Button
                            android:id="@+id/completeBtn"
                            style="@style/SmallButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="@string/complete" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/copySeedBtn"
                        style="@style/SmallButton"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:text="复制当前种子" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:background="@color/line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/records" />

                    <Button
                        android:id="@+id/clearRecordsBtn"
                        style="@style/SmallButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:minWidth="56dp"
                        android:text="@string/clear_records" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/recordsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- 居中浮层提示，对应 Web 版 .toast：不拦截触摸，自动淡出 -->
    <TextView
        android:id="@+id/toastCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_toast"
        android:clickable="false"
        android:elevation="8dp"
        android:focusable="false"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:maxWidth="300dp"
        android:minWidth="120dp"
        android:paddingLeft="20dp"
        android:paddingTop="12dp"
        android:paddingRight="20dp"
        android:paddingBottom="12dp"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
